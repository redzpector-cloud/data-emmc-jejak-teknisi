<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@color/jt_bg">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="JEJAK TEKNISI • GRADE eMMC" android:textSize="22sp"
        android:textStyle="bold" android:textColor="@color/jt_text" android:paddingBottom="12dp"/>
    <EditText android:id="@+id/search" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Cari kode / grade / kapasitas" android:textColor="@color/jt_text" android:textColorHint="@color/jt_muted"/>
    <Spinner android:id="@+id/filter" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/count" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/jt_muted" android:paddingVertical="8dp"/>
    <Button android:id="@+id/add" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="+ DATA" android:background="@drawable/bg_primary" android:textColor="@android:color/white"/>
</LinearLayout>
